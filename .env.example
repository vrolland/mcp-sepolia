# Copy to .env and fill in values. Never commit .env.

# --- Wallet: pick ONE ---
# Option A: local mnemonic (used when TURNKEY_API_PUBLIC_KEY is unset)
MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# Option B: Turnkey remote signer (takes priority over MNEMONIC when set)
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_SIGN_WITH=
# TURNKEY_API_BASE_URL=https://api.turnkey.com

# FOR HTTP
RN_CLIENT_ID=cli_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# RN_API_BASE=https://api.stage.request.network
# MCP_HTTP_PORT=3101
