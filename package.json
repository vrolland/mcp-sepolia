{
  "name": "mcp-sepolia",
  "version": "1.0.0",
  "description": "MCP server that pays a Request Network Secure Payment token on Ethereum Sepolia",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-sepolia": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/http-server.js",
    "start": "node build/index.js",
    "mcp:http": "npm run build && node build/http-server.js"
  },
  "keywords": [
    "mcp",
    "request-network",
    "sepolia"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@turnkey/sdk-server": "^8.2.1",
    "@turnkey/viem": "^0.14.36",
    "viem": "2.45.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
